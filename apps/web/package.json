{
  "name": "@hackclub/scrapbook",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun prisma generate && bun --bun next build",
    "start": "bun --bun next start --hostname 0.0.0.0",
    "generate": "bun --bun prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@better-auth/prisma-adapter": "1.7.10",
    "@hackclub/icons": "0.2.2",
    "@hackclub/meta": "1.2.1",
    "@hackclub/react-calendar-heatmap": "1.8.2",
    "@mdx-js/loader": "3.1.1",
    "@next/bundle-analyzer": "16.4.2",
    "@next/mdx": "16.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "dotenv": "18.0.8",
    "emoji-picker-react": "5.0.0",
    "github-slugger": "2.0.0",
    "hls.js": "1.7.3",
    "lodash-es": "4.18.1",
    "md5": "2.3.0",
    "next": "16.4.2",
    "node-statsd": "0.1.1",
    "nprogress": "0.2.0",
    "react": "19.3.1",
    "react-audio-player": "0.17.0",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.6.1",
    "react-masonry-css": "1.0.16",
    "react-tooltip": "6.0.9",
    "rss": "1.2.2",
    "superjson": "2.2.6",
    "swr": "2.5.1",
    "nodemailer": "10.1.2",
    "@mux/ts": "15.6.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prisma": "7.10.1"
  }
}
