{
  "name": "@hackclub/scrapbook-monorepo",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --cwd apps/web --bun next dev",
    "dev:slack-bot": "bun --cwd apps/slack-bot --watch src/app.js",
    "build": "bun --cwd apps/web --bun prisma generate && bun --cwd apps/web --bun next build",
    "build:web": "bun --cwd apps/web --bun prisma generate && bun --cwd apps/web --bun next build",
    "start": "bun --cwd apps/web --bun next start --hostname 0.0.0.0",
    "start:slack-bot": "bun --cwd apps/slack-bot src/app.js",
    "generate": "bun --cwd apps/web --bun prisma generate && bun --cwd apps/slack-bot --bun prisma generate",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "oxlint . && oxfmt --check . && bun test"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "sharp"
  ],
  "engines": {
    "bun": ">=1 <2"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  }
}
