{
  "name": "@hackclub/scrapbook-monorepo",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:slack-bot": "bun run --cwd apps/slack-bot dev",
    "build": "bun run --cwd apps/web build",
    "build:web": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "start:slack-bot": "bun run --cwd apps/slack-bot start",
    "generate": "bun run --cwd apps/web generate && bun run --cwd apps/slack-bot generate",
    "test": "bun test"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "sharp"
  ],
  "engines": {
    "bun": ">=1 <2"
  }
}
